# Copy to .env and fill in. .env is gitignored; never commit real values.
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_REDIRECT_URL=http://127.0.0.1:8765/callback
DATABASE_URL=postgresql://tradeline:tradeline@127.0.0.1:55432/tradeline
# KITE_ACCESS_TOKEN and KITE_ACCESS_TOKEN_ISSUED_ON are written here daily by `login`.
